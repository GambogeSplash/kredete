{
  // Type-checks the browser modules (JSDoc types over plain JavaScript; nothing is emitted).
  // The tools have their own project in tools/tsconfig.json. The support bot widget
  // (embed.js) is checked strictly too: it runs on other people's pages.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["types.d.ts", "globals.d.ts", "api.js", "capabilities.js", "sync.js", "embed.js", "bot-form.js", "domain-tree.js", "library-browse.js", "citations.js"]
}
